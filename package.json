{
  "name": "yxorp",
  "version": "0.3.0",
  "description": "A local reverse proxy for rewriting, mocking, and debugging API responses.",
  "keywords": [
    "reverse-proxy",
    "proxy",
    "http-proxy",
    "mock",
    "mock-server",
    "api-mock",
    "rewrite",
    "http",
    "api",
    "debugging",
    "cli",
    "developer-tools"
  ],
  "files": [
    "dist/",
    "bin/",
    "schema.json",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "main": "dist/index.js",
  "bin": {
    "yxorp": "bin/yxorp.js"
  },
  "scripts": {
    "start": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "author": "Kirill Suntsov",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/suntsovkirill/yxorp.git"
  },
  "bugs": {
    "url": "https://github.com/suntsovkirill/yxorp/issues"
  },
  "homepage": "https://github.com/suntsovkirill/yxorp#readme",
  "dependencies": {
    "http-encoding": "^2.2.0",
    "httpxy": "^0.5.3",
    "mime": "^3.0.0",
    "path-to-regexp": "^8.4.2",
    "qs": "^6.15.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tsconfig/node20": "^20.1.10",
    "@types/mime": "^3.0.4",
    "@types/node": "^20.19.41",
    "@types/qs": "^6.15.1",
    "@vitest/coverage-v8": "^4.1.7",
    "ajv": "^8.20.0",
    "eslint": "^10.14.0",
    "globals": "^16.5.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^4.1.7"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
